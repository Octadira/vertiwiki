{
  "title": "VertiWiki",
  "logo": "demo/assets/logo.svg",
  "favicon": "demo/assets/favicon.ico",
  "brandDisplay": "both",
  "useSideMenu": true,
  "useTableOfContents": true,
  "enableSearch": true,
  "enableMath": true,
  "enableMermaid": true,
  "enableCodeCopy": true,
  "enableThemeChooser": true,
